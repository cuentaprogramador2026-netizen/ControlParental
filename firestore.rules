rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dispositivos: solo lectura/escritura para el propio dispositivo
    match /devices/{deviceId} {
      allow read: if request.auth != null && request.auth.uid == deviceId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == deviceId;
      allow delete: if false;  // Nadie puede borrar
    }

    // Solicitudes: el hijo crea, el padre lee las suyas
    match /requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.childDeviceId == request.auth.uid ||
        resource.data.parentDeviceId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.childDeviceId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.parentDeviceId == request.auth.uid
      );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
